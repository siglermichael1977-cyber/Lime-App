{
  "expo": {
    "name": "Island Lime",
    "slug": "lime-caribbean",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lime",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#093F3A"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.mykkesigler.lime",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "LIME needs photo access so you can share pictures with the community."
      },
      "buildNumber": "21"
    },
    "android": {
      "package": "com.mykkesigler.lime",
      "permissions": [
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "8b3363dd-03aa-4bb1-9e2a-cc0f6d4ad82a"
      }
    },
    "owner": "1-1-1-1mykke"
  }
}
